# ==============================================================================
# GAAI (Gaming AI — Artificial Intelligence) Environment Configuration
# Target: ₹0/month production budget using verified free tiers & local inference
# ==============================================================================

# Node / Application Environment
NODE_ENV=production
PORT=5000
DAILY_RESET_TIMEZONE=Asia/Kolkata
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication & Session Security
JWT_SECRET=replace-with-a-secure-random-64-character-secret-string

# ------------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE (Supabase Free Tier or Embedded Store)
# ------------------------------------------------------------------------------
# If left empty, GAAI runs automatically in local file storage mode.
# To connect your Supabase PostgreSQL instance:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. FREE CLOUD AI PROVIDERS (Zero-cost free tiers)
# ------------------------------------------------------------------------------
# Google Gemini API (Free tier from https://aistudio.google.com/):
# Models: gemini-3.8-flash, gemini-3.5-flash, gemini-3.1-flash-lite (15 RPM free)
GEMINI_API_KEY=your-gemini-api-key-here

# Groq Cloud API (Free tier from https://console.groq.com/):
# Models: llama-3.3-70b-versatile, llama-3.1-8b-instant (~300 tokens/sec free)
GROQ_API_KEY=your-groq-api-key-here

# ------------------------------------------------------------------------------
# 3. LOCAL AI INFERENCE (100% Free & Private)
# ------------------------------------------------------------------------------
# Local Ollama endpoint (Default: http://localhost:11434/v1)
# Run locally: ollama run llama3 or ollama run mistral
OLLAMA_BASE_URL=http://localhost:11434/v1

# Generic OpenAI-Compatible Endpoint (LM Studio, LocalAI, OpenRouter, etc.)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ------------------------------------------------------------------------------
# 4. OPTIONAL PAID / CUSTOM PROVIDERS
# ------------------------------------------------------------------------------
# OpenAI API key (optional for DALL-E image generation fallback)
OPENAI_API_KEY=
